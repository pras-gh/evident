# Copy to .env (git-ignored); tools/dev.sh reads it. `tools/db.sh up` writes a
# .env from this file when there is none, with DATABASE_URL filled in.
#
# Values are read as KEY=value data, not sourced by a shell, so `&` and `?` in
# a connection string need no quoting.

# --- required
# PostgreSQL 15+ with pgvector. tools/db.sh up prints this for its database.
DATABASE_URL=postgresql+psycopg://you@localhost:5434/evident

# --- ingesting from SEC (POST /v1/ingest, workers). SEC refuses anonymous
# automated traffic; name the project and a contact.
# SEC_USER_AGENT=Parallx ingest (you@example.com)

# --- AI providers (docs/ai-gateway.md). Server-side only: the web app never
# sees them. Set the ones config/ai.toml routes to; a missing key makes that
# provider fail over to the next on the route. The demo needs none of them.
# GEMINI_API_KEY=                      # filing summarization, extraction, synthesis
# GROQ_API_KEY=                        # classification, and fallbacks
# ANTHROPIC_API_KEY=                   # complex financial reasoning

# --- AI gateway overrides — each beats config/ai.toml, no code change:
# AI_CONFIG_PATH=config/ai.toml
# AI_ROUTE_FILING_SUMMARIZATION=anthropic:claude-sonnet-5-5,gemini:gemini-3.5-flash-lite
#   (also AI_ROUTE_FINANCIAL_EXTRACTION, _CLASSIFICATION,
#    _COMPLEX_FINANCIAL_REASONING, _RESEARCH_SYNTHESIS)
# AI_LIMIT_MONTHLY_SPEND_USD=50        # per organization; orgs can override
# AI_LIMIT_MONTHLY_TOKENS=30000000
# AI_LIMIT_DAILY_REQUESTS_PER_USER=300
# AI_LIMIT_MAX_INPUT_TOKENS=200000
# AI_LIMIT_MAX_OUTPUT_TOKENS=16000
# AI_LOG_PROMPTS=0                     # 1 logs a redacted 500-char preview; debugging only
# AI_GEMINI_BASE_URL=                  # a proxy or test server (also _GROQ_, _ANTHROPIC_)

# --- search (POST /v1/search). No default on purpose: 'hashing' is for tests
# and has no semantics.
# EMBEDDING_PROVIDER=voyage            # search embeddings: voyage, gemini (uses GEMINI_API_KEY), openai
# EMBEDDING_MODEL=voyage-4-large       # 1024 dimensions, float; voyage-finance-2 / gemini-embedding-2 / text-embedding-3-large
# VOYAGE_API_KEY=                      # server-side only; never sent to the web app
# VOYAGE_RPM=                          # pace requests under your account's limits:
# VOYAGE_TPM=                          #   3 and 10000 a minute without a payment method
# EMBEDDING_PRICE_PER_MTOK=            # for the backfill's cost estimate; voyage-4-large defaults to 0.12
# OPENAI_API_KEY=
# Then index the chunks: python tools/generate_embeddings.py --dry-run, then without

# --- ports and origins, if the defaults clash with something
# API_PORT=8000
# WEB_PORT=3000
# CORS_ORIGINS=http://localhost:3000

# --- accounts (people signing in) — docs/accounts-billing.md
APP_URL=http://localhost:3000          # the web app's origin: cookies, redirects, Stripe returns
# APP_ENV=production                   # won't start without the production settings (docs/deployment.md)
# AUTH_PROVIDER=firebase               # or dev: local sign-in without a Firebase project
# FIREBASE_PROJECT_ID=                 # the API checks ID tokens' audience against this
# NEXT_PUBLIC_AUTH_PROVIDER=           # dev to match AUTH_PROVIDER=dev; else unset
# NEXT_PUBLIC_FIREBASE_API_KEY=        # the web app's Firebase config — public by design
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# SESSION_DAYS=30                      # a session's absolute lifetime
# SESSION_IDLE_DAYS=7                  # ...and how long it survives without a request
# CORS_ORIGINS=http://localhost:3000   # origins allowed to use the session cookie
# FREE_AI_QUERIES=10                   # AI research queries a free account gets, once

# --- billing (Stripe) — server only; never NEXT_PUBLIC_
# STRIPE_SECRET_KEY=                   # sk_test_… first, sk_live_… at launch
# STRIPE_WEBHOOK_SECRET=               # whsec_… of the endpoint …/v1/billing/webhook
# STRIPE_PRICE_IIX_MONTHLY=            # Iix, $19/month   — price_…
# STRIPE_PRICE_IIX_ANNUAL=             # Iix, $190/year
# STRIPE_PRICE_IIX_ANALYST_MONTHLY=    # IIx, $39/month
# STRIPE_PRICE_IIX_ANALYST_ANNUAL=     # IIx, $390/year
# STRIPE_PUBLISHABLE_KEY=              # not used: Checkout is created on the server
# BILLING_UNSUPPORTED_COUNTRIES=IN     # no USD checkout there (INR billing not yet verified)
# BILLING_GRACE_DAYS=7                 # a failed payment keeps the plan this long past the period
# Then: python tools/billing_check.py  (checks each Price's amount, interval and currency)

# --- production (docs/deployment.md). Hosts set these as service variables;
# none of them is needed to develop locally.
# FILING_STORE=s3://parallx-filings/prod  # filings, PDFs, page images: a bucket, since a
#                                      # container's disk is wiped on deploy (default: data/filings)
# S3_ENDPOINT_URL=https://<account id>.r2.cloudflarestorage.com   # Cloudflare R2
# S3_ACCESS_KEY_ID=                    # an R2 API token's key, Object Read & Write
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto                       # R2's only region
# DB_POOL_SIZE=3                       # per process: a hosted Postgres caps connections,
# DB_MAX_OVERFLOW=2                    #   and every API process, worker and fetch has a pool
# DB_PREPARED_STATEMENTS=off           # only behind a transaction-mode pooler (Supabase :6543)
# MIGRATION_DATABASE_URL=              # for `tools/serve.sh migrate`, if DATABASE_URL can't do DDL
# WEB_CONCURRENCY=2                    # API processes in one container
# API_DOCS=1                           # keep /docs on in production (off by default)
# PARALLX_ROLE=api                     # the image's role when none is given: api, sync, migrate
