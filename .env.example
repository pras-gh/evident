# Copy to .env (git-ignored); tools/dev.sh reads it. `tools/db.sh up` writes a
# .env from this file when there is none, with DATABASE_URL filled in.
#
# Values are read as KEY=value data, not sourced by a shell, so `&` and `?` in
# a connection string need no quoting.

# --- required
# PostgreSQL 15+ with pgvector. tools/db.sh up prints this for its database.
DATABASE_URL=postgresql+psycopg://you@localhost:5434/evident

# --- ingesting from SEC (POST /v1/ingest, workers). SEC refuses anonymous
# automated traffic; name the project and a contact.
# SEC_USER_AGENT=Evident ingest (you@example.com)

# --- live extraction with Claude (tools/extract_live.py, tools/benchmark.py).
# Not needed for the demo, which uses a keyword matcher.
# ANTHROPIC_API_KEY=

# --- search (POST /v1/search). No default on purpose: 'hashing' is for tests
# and has no semantics.
# EMBEDDING_PROVIDER=voyage            # or: openai
# VOYAGE_API_KEY=
# OPENAI_API_KEY=

# --- ports and origins, if the defaults clash with something
# API_PORT=8000
# WEB_PORT=3000
# CORS_ORIGINS=http://localhost:3000
